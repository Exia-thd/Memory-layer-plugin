{
  "name": "memory-layer-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Project memory layer for Claude — stores and retrieves why, not what.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli && node bin/build-stamp.mjs",
    "test": "node --test tests/*.test.js",
    "doctor": "node packages/cli/dist/cli.js doctor",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "@memory-layer/core": "workspace:*",
    "@memory-layer/cli": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ladybugdb/core",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
